// What fallow's static graph does not see. Nothing here loosens a limit: the
// three analyses (`dead-code`, `dupes`, `health`) run raw, as in the Festival
// dos Macacos (ADR 0005).
{
  "$schema": "./node_modules/fallow/schema.json",
  "dynamicallyLoaded": [
    // The Open Graph image is made by hand, `node scripts/og-image.ts` (the
    // comment at its top). No import points to it.
    "scripts/og-image.ts",
    // The brand icons and manifest, also by hand:
    // `node scripts/brand-icons.ts`.
    "scripts/brand-icons.ts",
    // The PR's screen evidence capture runs by hand,
    // `node scripts/capture.ts <route>` (docs/agents/screen-evidence.md).
    "scripts/capture.ts",
    // React Doctor finds `doctor.config.ts` by name, at the root of the
    // project it scans. No import points to it.
    "doctor.config.ts",
    // The screen tests' `@tanstack/react-start`: the `screens` project of
    // `vite.config.ts` points to it by alias, and no import does (ADR 0035).
    "src/platform/screens/test-server.ts",
  ],
  "duplicates": {
    "ignore": [
      // TanStack Router generates this file on every build, and the route
      // tree repeats the same shape for each route: a clone nobody can
      // refactor, because the generator rewrites it. Only `dupes` stops
      // looking.
      "src/routeTree.gen.ts",
    ],
  },
}
