# The variables the app, the build and the scripts read. None is required:
# without them, everything runs with the default. Copy to `.env` (ignored by
# git) only the ones you want to change.
#
# The build reads all of them from this file and from the shell, which wins,
# and validates them before starting (`vite/environment.ts`,
# `scripts/variaveis.ts`, ADR 0032): a wrong one stops the command, with its
# name. Empty counts as absent. The ports and the deploy ones come only from
# the shell, in front of the command, and are commented out here, with an
# example.

# `1` also counts visits on localhost. Only the e2e build turns it on
# (`playwright.config.ts`), for the analytics test to see the send.
VITE_COUNT_ON_LOCALHOST=

# The library root the build reads (`vite/library.ts`). Without it, the
# repository root. The e2e uses the fixture.
# CONTENT_ROOT=e2e/library

# The live sitemap, downloaded to a file. With it the build checks that no
# published path disappeared without `antes`. CI and the deploy pass it.
# SITEMAP_ANTERIOR=/tmp/sitemap-anterior.xml

# The ports. Without them, the checkout's (`node scripts/portas.ts`): 4310 to
# 4312 and 6310 to 6311 in the main checkout, a block of its own in each
# worktree (ADR 0010). Change one only when a script says it is taken.
# DEV_PORTA=5000
# START_PORTA=5001
# E2E_PORTA=5002
# STORYBOOK_PORTA=5003
# STORIES_PORTA=5004

# The folder of the raw IBGE data for `pnpm dados:grupo-possivel`. Without
# it, `~/.cache/tem-estudo/brutos`.
# BRUTOS_DIR=/srv/brutos

# Deploy (`scripts/vps.ts`, `docs/deploy.md`): the VPS, the SSH key and the
# GoatCounter login e-mail.
# VPS_HOST=203.0.113.10
# VPS_USER=root
# VPS_PORT=22
# VPS_SSH_KEY=~/.ssh/temestudo
# GOATCOUNTER_EMAIL=voce@example.com

# `1` runs the GoatCounter test in Docker (`scripts/stats.docker.test.ts`).
# TESTAR_GOATCOUNTER=1
