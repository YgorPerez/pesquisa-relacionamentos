{
  "name": "frontend",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node ../scripts/dev.ts",
    "build": "vp build",
    "start": "node ../scripts/dev.ts start",
    "typecheck": "tsc --noEmit",
    "cn:tabelas": "cn build --full --quiet --css src/styles.css -o src/platform/cn-tabelas.js",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "e2e": "playwright test",
    "storybook": "node ../scripts/dev.ts storybook",
    "build-storybook": "storybook build",
    "test:stories": "vp test run --config vitest.stories.config.ts",
    "fallow": "fallow dead-code && fallow dupes && fallow health --coverage coverage/coverage-final.json --min-score 90",
    "doctor": "react-doctor --no-score --blocking warning"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@tem-estudo/conteudo": "workspace:*",
    "@tem-estudo/regras": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "marked": "^18.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.29.7",
    "@playwright/test": "1.64.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@total-typescript/ts-reset": "catalog:",
    "@types/babel__core": "^7.20.5",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "babel-plugin-react-compiler": "^1.0.0",
    "fallow": "3.31.0",
    "nitro": "3.0.260903-beta",
    "playwright": "1.64.0",
    "react-doctor": "^0.9.17",
    "storybook": "^10.6.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "catalog:"
  }
}
