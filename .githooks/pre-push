#!/bin/sh
# The push gate (docs/agents/integracao.md, ADR 0020), from Festival dos
# Macacos. Git runs this at the worktree root. Only `node`, no pnpm: pnpm is
# run by `scripts/verify-push.ts`. `git push --no-verify` skips this hook.
#
# `core.hooksPath` may name another worktree's `.githooks/`: Claude Code writes
# the main checkout's absolute path when it creates an agent's worktree. So
# this hook hands off to the `.githooks/pre-push` of the worktree doing the
# push, if it exists and is a different file. The variable stops the way back.
if [ -z "$TEM_ESTUDO_PRE_PUSH_FORWARDED" ]; then
  root=$(git rev-parse --show-toplevel) || exit 1
  here=$(cd -P "$(dirname "$0")" && pwd)
  theirs=$(cd -P "$root/.githooks" 2>/dev/null && pwd)
  if [ -f "$root/.githooks/pre-push" ] && [ "$here" != "$theirs" ]; then
    TEM_ESTUDO_PRE_PUSH_FORWARDED=1
    export TEM_ESTUDO_PRE_PUSH_FORWARDED
    exec sh "$root/.githooks/pre-push" "$@"
  fi
  # A worktree without the hook (a branch from before it) lacks the script.
  if [ ! -f "$root/scripts/verify-push.ts" ]; then
    echo "[pre-push] $root has no scripts/verify-push.ts: nothing to check." >&2
    exit 0
  fi
fi
unset TEM_ESTUDO_PRE_PUSH_FORWARDED
exec node scripts/verify-push.ts "$@"
