{
  // Pacote puro, sem build e sem dependência em runtime: quem importa (o Vite
  // no app, o Vitest aqui) transpila o `.ts`. Sem os tipos do `node` e sem DOM,
  // para a mesma regra rodar no servidor e no navegador.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
