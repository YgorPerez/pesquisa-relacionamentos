{
  // Pacote puro, sem build: quem importa (o Vite no app, o Vitest aqui)
  // transpila o `.ts`. Os tipos são os do `node`, o mais estrito com extensão
  // de import.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
