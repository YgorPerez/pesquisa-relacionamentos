{
  // Pure package, no build: whoever imports it (Vite in the app, Vitest here)
  // transpiles the `.ts`. The types are `node`'s, the strictest with import
  // extensions.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    // Effect's diagnostics in `tsc`, through the `@effect/tsgo` patch the
    // root `prepare` applies (ADR 0004). Oxlint gives the same ones, through
    // the `effecttsgo` plugin in the root `vite.config.ts`.
    "plugins": [{ "name": "@effect/language-service" }]
  },
  "include": ["src/**/*.ts"]
}
