{
  // Pacote puro, sem build: quem importa (o Vite no app, o Vitest aqui)
  // transpila o `.ts`. Os tipos são os do `node`, o mais estrito com extensão
  // de import.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    // Os diagnósticos do Effect no `tsc`, pelo patch do `@effect/tsgo` que o
    // `prepare` da raiz aplica (ADR 0004). O Oxlint dá os mesmos, pelo
    // plugin `effecttsgo` do `vite.config.ts` da raiz.
    "plugins": [{ "name": "@effect/language-service" }]
  },
  "include": ["src/**/*.ts"]
}
