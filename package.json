{
  "name": "tem-estudo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "dev": "pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build",
    "start": "pnpm --filter frontend start",
    "check": "vp check && node frontend/lint/folders.ts && node frontend/lint/stories.ts && node scripts/study-index.ts --check && vp run -r --cache test:coverage && vp run --filter frontend fallow && vp run --filter frontend doctor",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "test": "vp test run && vp run --filter ./frontend --filter './packages/*' --cache test",
    "test:coverage": "vp test run --coverage",
    "data:possible-group": "node scripts/possible-group/pipeline.ts",
    "typecheck": "vp run -r --cache typecheck",
    "verify": "node scripts/verify-fact-sheet.ts",
    "e2e": "pnpm --filter frontend e2e",
    "storybook": "pnpm --filter frontend storybook",
    "build-storybook": "pnpm --filter frontend build-storybook",
    "test:stories": "pnpm --filter frontend test:stories",
    "test:storybook": "pnpm --filter frontend test:storybook"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@shadcn/lint": "^0.2.1",
    "@t3-oss/env-core": "^0.13.11",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.10.1"
}
